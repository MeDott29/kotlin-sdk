<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/agentNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agent Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary" />

        <TextView
            android:id="@+id/agentDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agent description goes here"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/agentInterestsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Interests: technology, science, art"
            android:textSize="12sp"
            android:textStyle="italic"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to view content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="end"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView> 