<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contentCardView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/card_background">

    <!-- Front side of the card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardFrontSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/contentTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHeight_percent="0.5">

            <ImageView
                android:id="@+id/contentImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/content_image"
                android:scaleType="centerCrop"
                tools:src="@color/medium_gray" />

            <TextView
                android:id="@+id/aiThoughtsText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ai_thoughts_background"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="@color/ai_thoughts_text"
                android:textSize="16sp"
                android:visibility="gone"
                android:scrollbars="vertical"
                tools:text="AI's thoughts about generating this content..."
                tools:visibility="visible" />

        </FrameLayout>

        <TextView
            android:id="@+id/contentTitle"
            style="@style/CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/tagsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageContainer"
            tools:text="Content Title" />

        <LinearLayout
            android:id="@+id/tagsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@+id/contentTitle"
            app:layout_constraintBottom_toTopOf="@+id/contentDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <!-- Tags will be added here dynamically -->
        </LinearLayout>

        <TextView
            android:id="@+id/contentDescription"
            style="@style/CardContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toTopOf="@+id/generatedByText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tagsContainer"
            tools:text="Content description goes here. This can be a longer text that describes the content in detail." />

        <TextView
            android:id="@+id/generatedByText"
            style="@style/CardFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/generated_by"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tapToFlipText"
            style="@style/CardFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to see creation details"
            android:drawablePadding="4dp"
            app:drawableStartCompat="@android:drawable/ic_menu_info_details"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/likeOverlay"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:alpha="0"
            android:contentDescription="@string/swipe_right_to_like"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/like_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/rejectOverlay"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:alpha="0"
            android:contentDescription="@string/swipe_left_to_reject"
            android:src="@android:drawable/ic_delete"
            app:tint="@color/reject_red"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Back side of the card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardBackSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/creationSummaryTitle"
            style="@style/CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Content Creation Summary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/tapToFlipBackText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creationSummaryTitle">

            <TextView
                android:id="@+id/creationSummaryText"
                style="@style/CardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="This content was created using the following process..." />
        </ScrollView>

        <TextView
            android:id="@+id/tapToFlipBackText"
            style="@style/CardFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to return to content"
            android:drawablePadding="4dp"
            app:drawableStartCompat="@android:drawable/ic_menu_revert"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView> 